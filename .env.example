APP_NAME="Time Capsule API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8620

# The application runs on UTC. Every timestamp crossing the API carries an
# explicit offset, so clients never have to guess. Changing this changes the
# instant a capsule unlocks.
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The docker compose stack uses mysql on the service name below. For a
# zero-infrastructure local run use sqlite instead — DB_DATABASE must then be
# an absolute path to the file:
#   DB_CONNECTION=sqlite
#   DB_DATABASE=/absolute/path/to/database/database.sqlite
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dealers_united
DB_USERNAME=dealers_united
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Comma-separated client origins. '*' is the local-development default; set a
# real list in every other environment.
CORS_ALLOWED_ORIGINS=*

# Hosts that may authenticate with a session cookie rather than a bearer
# token. The Vue client uses a bearer token, so this only matters if you add a
# first-party SPA on the same site.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8080,127.0.0.1,127.0.0.1:8080

# Capsule behaviour — see config/capsules.php.
CAPSULE_PREVIEW_LENGTH=4
CAPSULE_MAX_NOTE_LENGTH=5000
CAPSULE_DEFAULT_PER_PAGE=15
CAPSULE_MAX_PER_PAGE=100

# Host ports published by docker-compose.yml.
APP_PORT=8620
FORWARD_DB_PORT=8623
FORWARD_REDIS_PORT=8624
FORWARD_MAILPIT_PORT=8625
FORWARD_MAILPIT_DASHBOARD_PORT=8626
